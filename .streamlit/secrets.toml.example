# Copie para .streamlit/secrets.toml e preencha. NÃO versione o arquivo preenchido.

# ---- Login com Google (OpenID Connect nativo do Streamlit) ----
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # em produção: https://SEU-APP/oauth2callback
cookie_secret = "TROQUE-POR-UMA-STRING-ALEATORIA-LONGA"
client_id = "SEU-ID.apps.googleusercontent.com"
client_secret = "SEU-SEGREDO"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ---- Quem pode acessar as áreas restritas (e-mails da conta Google) ----
[access]
admins = ["admin@exemplo.org"]

[access.researchers]
# "e-mail" = "validade AAAA-MM-DD"   (vazio = sem prazo)
"pesquisador1@universidade.edu.br" = "2027-06-30"
"pesquisador2@gmail.com" = ""

# ---- Privacidade (LGPD) ----
[privacy]
k_min = 1                                        # tamanho mínimo de célula divulgada
pseudo_secret = "TROQUE-POR-UMA-CHAVE-ALEATORIA-LONGA"   # guarde também fora do app; se perder, os códigos mudam

# ---- Dados ----
[data]
backend = "xlsx"                                 # "xlsx" (hoje) ou "postgres" (Supabase, próxima etapa)
# xlsx_path = "data/minha_planilha.xlsx"         # padrão: primeiro .xlsx da pasta data/
# postgres_url = "postgresql+psycopg2://usuario:senha@host:5432/postgres"

# ---- Auditoria ----
[audit]
# path = "logs/log_acesso.csv"

# ---- Desenvolvimento: escolhe o nível sem login. NUNCA ligue em produção. ----
[dev]
enabled = false
